---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';

import { SITE, EMAIL, LINKEDIN } from '../config';
import { alternates, type Dict, type Locale } from '../i18n';

interface Props { t: Dict; locale: Locale; noindex?: boolean; }
const { t, locale, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(`/og/og-${locale}.png`, SITE).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Red Desk',
  alternateName: 'red_desk',
  url: SITE,
  logo: new URL('/icon-512.png', SITE).href,
  email: EMAIL,
  description: t.meta.description,
  ...(LINKEDIN ? { sameAs: [LINKEDIN] } : {}),
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {alternates().map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, SITE).href} />
    ))}

    <meta name="theme-color" content="#141312" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Red Desk" />
    <meta property="og:locale" content={t.htmlLang} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(org)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>
