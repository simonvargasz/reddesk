---
/**
 * Banner ASCII de Red Desk. La retícula la calcula src/lib/ascii.mjs, que
 * comparte con el generador de OG images; el arte vive en assets/ascii-logo.txt.
 *
 * Dos composiciones del mismo arte, conmutadas por CSS (sin JS, sin salto):
 *  - ancha: "RED_DESK" en una línea, para >=600px.
 *  - apilada: "RED_" sobre "DESK", para teléfonos. En una sola línea el bloque
 *    mediría 6px de lado en un móvil; apilado mide 12px y el logo manda.
 */
import raw from '../assets/ascii-logo.txt?raw';
import { buildBanner, buildStackedBanner } from '../lib/ascii.mjs';

/* Radios del florecimiento, en unidades del arte, así que escalan con el logo.
   Pero escalar no es lo mismo que leerse igual: la composición apilada ocupa el
   ancho entero de un teléfono y se mira a 30cm, y ahí el mismo halo proporcional
   se come el bloque. La apilada florece menos. */
const ART = {
  wide:  { bloom: { wide: 0.30, tight: 0.075 }, halo: 0.34, edge: 0.55 },
  stack: { bloom: { wide: 0.21, tight: 0.065 }, halo: 0.24, edge: 0.45 },
};
const wide = buildBanner(raw);
const stack = buildStackedBanner(raw);
const PX_PER_EM = 19; // equivalente al font-size máximo de la maqueta
---
<div class="banner">
  {[
    { id: 'wide', b: wide, cls: 'banner__svg--wide', a: ART.wide },
    { id: 'stack', b: stack, cls: 'banner__svg--stack', a: ART.stack },
  ].map(({ id, b, cls, a }) => (
    <svg
      class:list={['banner__svg', cls]}
      viewBox={`0 0 ${b.width.toFixed(3)} ${b.height.toFixed(3)}`}
      width={Math.round(b.width * PX_PER_EM)}
      height={Math.round(b.height * PX_PER_EM)}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <!-- Florecimiento, y nada más. El fósforo no dibuja bordes: los quema.
             Dos desenfoques bajo el arte nítido dan el halo, y cada uno conserva
             el color del trazo que lo emite —cosa que un drop-shadow de un solo
             color no puede hacer—.

             Aquí hubo también una aberración cromática, separando el canal R del
             par G+B sobre el halo. Es correcta como óptica y se retiró de todas
             formas: sobre los bloques blancos del logo se lee como una aureola
             de color, cálida por un flanco y cian por el otro, y este monitor es
             de un solo fósforo. Un tubo rojo no tiene por qué separar espectro
             que no emite. -->
        <filter
          id={`rd-bloom-${id}`}
          x="-30%" y="-70%" width="160%" height="240%"
          color-interpolation-filters="sRGB"
        >
          <feGaussianBlur in="SourceGraphic" stdDeviation={a.bloom.wide} result="wide" />
          <feComponentTransfer in="wide" result="halo">
            <feFuncA type="linear" slope={a.halo} />
          </feComponentTransfer>
          <feGaussianBlur in="SourceGraphic" stdDeviation={a.bloom.tight} result="tight" />
          <feComponentTransfer in="tight" result="edge">
            <feFuncA type="linear" slope={a.edge} />
          </feComponentTransfer>
          <feMerge>
            <feMergeNode in="halo" />
            <feMergeNode in="edge" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <g class="banner__lit" filter={`url(#rd-bloom-${id})`}>
        {Array.from({ length: b.rows }, (_, r) => (
          <g class="banner__row" style={`--i:${r}`}>
            {b.rects.filter((rect) => rect.r === r).map((rect) => (
              <rect x={rect.x} y={rect.y} width={rect.w} height={rect.h} fill={rect.fill} />
            ))}
          </g>
        ))}
      </g>
    </svg>
  ))}
</div>

<style>
  .banner { width: 100%; }
  .banner__svg {
    display: block;
    width: 100%;
    height: auto;
    /* El logo manda el eje del hero: todo lo demás se alinea con su centro. */
    margin-inline: auto;
    /* El halo se sale de la caja del arte, y ahí es donde tiene que estar. */
    overflow: visible;
  }
  /* Dentro de una pantalla acotada, el logo llena la medida en vez de dejar
     muerto el tercio derecho del cristal. La maqueta original lo topaba en
     570px porque el hero iba a sangre y no tenía marco que llenar. */
  .banner__svg--wide { max-width: min(100%, 820px); }
  /* La apilada iba a sangre de canalón a canalón y el logo dejaba de tener
     aire: en un teléfono, un bloque que toca los dos bordes se lee apretado,
     no grande. Se le deja margen y sigue mandando en la pantalla. */
  .banner__svg--stack { display: none; max-width: min(87%, 320px); }

  @media (max-width: 599px) {
    .banner__svg--wide { display: none; }
    .banner__svg--stack { display: block; }
  }

  .banner__row {
    /* El arranque: el banner se dibuja fila a fila antes que nada, y el
       revelado del resto de la página entra detrás. */
    animation: rdBoot .55s cubic-bezier(.16, 1, .3, 1) backwards;
    animation-delay: calc(var(--i) * 55ms);
  }
  @keyframes rdBoot { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .banner__row { animation: none; }
  }
  /* Quien pide más contraste quiere el filo de la letra, no el halo ni la
     franja de color: el CSS gana al atributo de presentación. */
  @media (prefers-contrast: more) {
    .banner__lit { filter: none; }
  }
</style>
