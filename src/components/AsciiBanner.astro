---
/**
 * Banner ASCII de Red Desk. La retícula la calcula src/lib/ascii.mjs, que
 * comparte con el generador de OG images; el arte vive en assets/ascii-logo.txt.
 */
import raw from '../assets/ascii-logo.txt?raw';
import { buildBanner, ROW_H } from '../lib/ascii.mjs';

const { rects, rows, width, height } = buildBanner(raw);
const PX_PER_EM = 19; // equivalente al font-size máximo de la maqueta
---
<div class="banner">
  <svg
    class="banner__svg"
    viewBox={`0 0 ${width.toFixed(3)} ${height.toFixed(3)}`}
    width={Math.round(width * PX_PER_EM)}
    height={Math.round(height * PX_PER_EM)}
    aria-hidden="true"
    focusable="false"
  >
    {Array.from({ length: rows }, (_, r) => (
      <g class="banner__row" style={`--i:${r}`}>
        {rects.filter((rect) => rect.r === r).map((rect) => (
          <rect x={rect.x} y={rect.y} width={rect.w} height={rect.h} fill={rect.fill} />
        ))}
      </g>
    ))}
  </svg>
</div>

<style>
  .banner { width: 100%; }
  .banner__svg {
    display: block;
    width: 100%;
    /* Techo equivalente al font-size:19px de la maqueta (50 col x 0.6em). */
    max-width: 570px;
    height: auto;
  }
  .banner__row {
    /* Único momento animado de la página: el banner se dibuja fila a fila. */
    animation: rdBoot .55s cubic-bezier(.16, 1, .3, 1) backwards;
    animation-delay: calc(var(--i) * 55ms);
  }
  @keyframes rdBoot { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .banner__row { animation: none; }
  }
</style>
