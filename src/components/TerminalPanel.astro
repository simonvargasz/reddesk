---
/**
 * El panel de terminal de la maqueta original. En el diseño imprimía métricas
 * de despliegue inventadas; aquí imprime los principios del estudio, que son
 * verificables. Mismo dispositivo visual, ninguna afirmación falsa.
 */
interface Props { command: string; lines: string[]; last: string; }
const { command, lines, last } = Astro.props;
---
<div class="term" role="img" aria-label={`${command}: ${[...lines, last].join('. ')}`}>
  <div class="term__bar" aria-hidden="true">
    <span class="term__dot term__dot--live"></span>
    <span class="term__dot"></span>
    <span class="term__dot"></span>
  </div>
  <div class="term__body" aria-hidden="true">
    <p class="term__cmd"><span class="term__prompt">$</span> {command}</p>
    {lines.map((line) => <p class="term__out">&rarr; {line}</p>)}
    <p class="term__last">&rarr; {last} <span class="cursor term__cursor"></span></p>
  </div>
</div>

<style>
  .term {
    width: 100%;
    max-width: 460px;
    background: var(--rd-panel);
    border: 1px solid var(--rd-graphite);
    border-radius: 8px;
    overflow: hidden;
  }
  .term__bar {
    height: 34px;
    background: var(--rd-graphite);
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline: 12px;
  }
  .term__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--rd-graphite-2); }
  .term__dot--live { background: var(--rd-red); }
  .term__body {
    padding: 26px;
    font-family: var(--rd-mono);
    font-size: 12.5px;
    line-height: 2;
    color: var(--rd-ink-2);
  }
  .term__prompt { color: var(--rd-ink-4); }
  .term__out { color: var(--rd-ink-3); }
  .term__last { color: var(--rd-ink); display: flex; align-items: center; gap: 6px; }
  .term__cursor { width: 7px; height: 13px; }

  @media (max-width: 420px) {
    .term__body { padding: 20px; font-size: 11.5px; }
  }
</style>
