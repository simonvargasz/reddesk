---
import LangSwitcher from './LangSwitcher.astro';
import { EMAIL } from '../config';
import type { Dict, Locale } from '../i18n';

interface Props { t: Dict; locale: Locale; }
const { t, locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__inner shell">
    <!-- Marca Cursor (wordmark). Nunca en la misma cara que Terminal RD. -->
    <p class="wordmark">
      <span class="wordmark__text">red_desk</span>
      <span class="wordmark__block" aria-hidden="true"></span>
    </p>

    <div class="site-footer__end">
      <LangSwitcher current={locale} label={t.nav.language} />
      <p class="meta site-footer__legal">
        &copy; {year} Red Desk &middot; <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>
  </div>
  <p class="meta site-footer__built shell">{t.footer.built}</p>
</footer>

<style>
  /* El mismo problema del área segura, por el otro extremo: en un teléfono con
     indicador de inicio la última línea del pie quedaba justo debajo de él. El
     fondo del pie sí llega al canto —es lo que debe hacer—; lo que se aparta es
     el texto. */
  .site-footer {
    border-top: 1px solid var(--rd-graphite);
    background: var(--rd-black-deep);
    padding-block: 32px calc(32px + var(--rd-safe-bottom));
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .site-footer__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .wordmark { display: flex; align-items: center; gap: 6px; }
  .wordmark__text {
    font-family: var(--rd-mono);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    color: var(--rd-ink);
  }
  /* El asset negativo usa #FF4A54 sobre oscuro, no #8C1420. */
  .wordmark__block { width: 8px; height: 15px; background: var(--rd-red-ink); }

  .site-footer__legal a { color: var(--rd-ink-4); }
  .site-footer__legal a:hover { color: var(--rd-ink); }
  .site-footer__built {
    margin: 24px auto 0;
    color: var(--rd-ink-4);
    letter-spacing: 0.1em;
  }

  @media (max-width: 860px), (pointer: coarse) {
    .site-footer__legal { line-height: 2.4; }
    .site-footer__legal a { display: inline-block; padding-block: 12px; }
  }

  @media (max-width: 599px) {
    .site-footer { padding-block: 30px calc(34px + var(--rd-safe-bottom)); }
    .site-footer__inner { flex-direction: column; align-items: flex-start; gap: 24px; }
    .site-footer__end { flex-direction: column; align-items: flex-start; gap: 18px; }
    .wordmark__text { font-size: 16px; }
    .wordmark__block { width: 9px; height: 17px; }
    .site-footer__built { margin-top: 22px; line-height: 1.8; }
  }
</style>
