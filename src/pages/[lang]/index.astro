---
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AsciiBanner from '../../components/AsciiBanner.astro';
import LangSwitcher from '../../components/LangSwitcher.astro';
import TerminalPanel from '../../components/TerminalPanel.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import { EMAIL, LINKEDIN, LOCALES } from '../../config';
import { t as dict, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
---
<Base t={t} locale={locale}>
  <main id="main">
    <!-- Sin barra de navegación: la página se recorre bajando y nada la sigue
         por arriba. El único mando que sobrevive al hero es el selector de
         idioma, que se va con el scroll como todo lo demás. -->
    <section class="hero">
      <div class="hero__langs">
        <LangSwitcher current={locale} label={t.nav.language} />
      </div>

      <div class="shell hero__inner">
        <h1 class="hero__h1">
          <AsciiBanner />
          <span class="visually-hidden">Red Desk — {t.hero.tagline}</span>
        </h1>

        <p class="hero__tagline" aria-hidden="true">
          <span class="hero__prompt">$</span>
          <span class="hero__tag">{t.hero.tagline}</span>
          <span class="cursor hero__cursor"></span>
        </p>

        <p class="hero__lead" data-reveal style="--rd-reveal-delay:400ms">{t.hero.lead}</p>

        <div class="hero__actions" data-reveal style="--rd-reveal-delay:500ms">
          <a class="btn btn--primary" href="#que-hace">{t.hero.primary}</a>
          <a class="btn btn--ghost" href="#contacto">{t.hero.secondary}</a>
        </div>
      </div>
    </section>

    <section id="enfoque" class="section" aria-labelledby="h-enfoque">
      <div class="shell">
        <SectionHeader n={t.thesis.n} title={t.thesis.title} id="h-enfoque" />
        <div class="thesis">
          <div class="thesis__body">
            {t.thesis.body.map((p, i) => (
              <p class="prose" data-reveal style={`--rd-reveal-delay:${i * 90}ms`}>{p}</p>
            ))}
          </div>
          <div class="thesis__aside" data-reveal style="--rd-reveal-delay:180ms">
            <TerminalPanel
              command={t.thesis.terminal.command}
              lines={t.thesis.terminal.lines}
              last={t.thesis.terminal.last}
            />
          </div>
        </div>
      </div>
    </section>

    <section id="que-hace" class="section section--deep" aria-labelledby="h-que-hace">
      <div class="shell">
        <SectionHeader n={t.services.n} title={t.services.title} id="h-que-hace" />
        <ul class="cards screen-surface">
          {t.services.items.map((item, i) => (
            <li class="card" data-reveal style={`--rd-reveal-delay:${i * 100}ms`}>
              <span class="card__rule" aria-hidden="true"></span>
              <h3 class="card__title">{item.title}</h3>
              <p class="card__body">{item.body}</p>
            </li>
          ))}
        </ul>
        <p class="not" data-reveal>
          <span class="not__label">{t.services.notLabel}</span>
          <span class="not__text">{t.services.not}</span>
        </p>
      </div>
    </section>

    <section id="proceso" class="section" aria-labelledby="h-proceso">
      <div class="shell">
        <SectionHeader n={t.process.n} title={t.process.title} id="h-proceso" />
        <ol class="steps">
          {t.process.steps.map((step, i) => (
            <li class="step" data-reveal style={`--rd-reveal-delay:${i * 100}ms`}>
              <p class="label step__when">{step.when}</p>
              <h3 class="step__title">{step.title}</h3>
              <p class="card__body">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="contacto" class="section section--deep" aria-labelledby="h-contacto">
      <div class="shell contact">
        <div class="contact__intro">
          <SectionHeader n={t.contact.n} title={t.contact.title} id="h-contacto" lg />
          <p class="prose contact__lead" data-reveal style="--rd-reveal-delay:90ms">{t.contact.lead}</p>

          <dl class="channels" data-reveal style="--rd-reveal-delay:150ms">
            <div class="channel">
              <dt class="channel__k">{t.contact.emailLabel}</dt>
              <dd class="channel__v"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
            </div>
            {LINKEDIN && (
              <div class="channel">
                <dt class="channel__k">{t.contact.linkedinLabel}</dt>
                <dd class="channel__v">
                  <a href={LINKEDIN} rel="me noopener" target="_blank">{t.contact.linkedinCta}</a>
                </dd>
              </div>
            )}
          </dl>
        </div>

        <div class="contact__panel screen-surface" data-reveal style="--rd-reveal-delay:120ms">
          <ContactForm t={t} />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter t={t} locale={locale} />
</Base>

<style>
  /* ---------- hero ----------
     No es una pantalla, es el efecto. La sección es una banda a todo el ancho
     sin fondo propio —hereda el negro de la página, así que no hay canto donde
     empiece ni acabe— y el tubo se pinta en dos capas que abrazan el contenido:
     el cañón detrás, el barrido delante.

     Sin barra pegajosa el hero ocupa el pliegue entero y es la portada: el logo
     va centrado y el resto se alinea con él. */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(72px, 10vw, 112px) clamp(76px, 9vw, 108px);
    min-height: 100svh;
    display: grid;
    /* Pista explícita: una columna `auto` encoge al max-content del contenido y
       .shell deja de caer sobre la medida de la página. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    /* La luz no debe chocar contra el resto del cuerpo. Las dos capas se
       disuelven hacia abajo, así que la textura y la viñeta mueren mucho antes
       del filete de la sección siguiente y el hero se funde con el fondo en vez
       de cortarse. */
    --rd-hero-fade: linear-gradient(
      to bottom, #000 0%, #000 42%, transparent 100%);
  }
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    -webkit-mask-image: var(--rd-hero-fade);
            mask-image: var(--rd-hero-fade);
  }
  /* El cañón: detrás del texto, para que ilumine sin velarlo.
     Encima lleva las dos huellas de un cristal convexo:
       · el ARCO de refracción — la luz que un vidrio curvo devuelve no es una
         banda recta sino un arco, y aquí sube ~150px del canto al centro. Es la
         única lectura de curvatura que sobrevive: se probó arquear el propio
         barrido y sobre fondo negro modula un nivel de luminancia, así que su
         comba es invisible y no compensa un degradado radial de 18.000px;
       · el reflejo diagonal de la sala, muy abierto y sin canto, para que se lea
         como atmósfera y no como el objeto que quitamos. */
  .hero::before {
    z-index: 0;
    background:
      radial-gradient(120% 175% at 50% 175%,
        transparent 70%,
        rgba(255, 255, 255, .034) 78%,
        rgba(255, 255, 255, .011) 86%,
        transparent 96%),
      linear-gradient(107deg,
        rgba(255, 255, 255, .034) 0%, rgba(255, 255, 255, .011) 20%, transparent 42%),
      radial-gradient(72% 92% at 50% 34%,
        rgba(140, 20, 32, .28) 0%, rgba(140, 20, 32, .10) 46%, transparent 78%),
      radial-gradient(100% 90% at 50% 28%, rgba(255, 255, 255, .026), transparent 78%);
  }
  /* El cristal, delante de todo: el barrido —mismo token que los paneles— y la
     viñeta, ancha y tardía, que apaga los flancos de una banda apaisada y no
     las esquinas de una caja.

     Aquí hubo una tercera capa: una aberración de cantos, cálida por la
     izquierda y fría por la derecha. Se fue con la del logo y por la misma
     razón: este monitor es de un solo fósforo, y una banda azul en el canto
     derecho no se lee como refracción sino como un tinte que nadie pidió. */
  .hero::after {
    z-index: 2;
    background:
      var(--rd-scan-soft),
      radial-gradient(120% 130% at 50% 45%, transparent 62%, rgba(0, 0, 0, .34) 100%);
  }
  @media (prefers-contrast: more), (prefers-reduced-transparency: reduce) {
    .hero::before, .hero::after { display: none; }
  }

  /* El selector de idioma es lo único que queda de la barra. Va suelto en el
     canto del hero y se marcha con el scroll: no es una navegación, es un
     ajuste que se toca una vez. */
  .hero__langs {
    position: absolute;
    z-index: 3;
    top: clamp(12px, 2vw, 20px);
    right: max(var(--rd-gutter), env(safe-area-inset-right));
  }
  /* El selector se dibuja con caja para el dedo, y esa caja lo convertía en la
     barra que acabamos de quitar. Dentro del hero conserva el blanco táctil y
     pierde el marco: sólo el idioma activo lleva bloque. */
  .hero__langs :global(.langs__item) { border-color: transparent; }
  .hero__langs :global(.langs__item[aria-current]) {
    border-color: transparent;
    background: var(--rd-graphite);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    /* Anchura definida: en grid, las márgenes `auto` de .shell encogen el ítem
       al max-content en vez de estirarlo, y el hero se descolgaba de la medida
       de la página. */
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__h1 { width: 100%; margin: 0; }

  .hero__tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: clamp(22px, 3vw, 28px);
    font-family: var(--rd-mono);
    font-size: clamp(12.5px, 3.2vw, 18px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rd-ink-2);
  }
  /* Todo lo que está sobre el tubo emite: el fósforo desborda el trazo. El
     cuerpo lleva el halo justo hasta donde ayuda a la ilusión sin robar filo
     a la letra. */
  .hero__prompt {
    color: var(--rd-red-ink);
    font-weight: 500;
    text-shadow: 0 0 10px rgba(255, 74, 84, .7), 0 0 24px rgba(255, 74, 84, .35);
  }
  .hero__tag {
    min-width: 0;
    text-shadow: 0 0 12px rgba(214, 210, 205, .38);
  }
  .hero__cursor {
    width: 9px;
    height: 18px;
    box-shadow: 0 0 10px rgba(255, 74, 84, .85), 0 0 22px rgba(255, 74, 84, .45);
  }

  /* Centrada como bloque, justificada de renglón: los flancos quedan a plomo y
     la última línea vuelve al centro, que es lo que sostiene el eje del logo.
     La medida sube a 56ch porque justificar en corto abre ríos entre palabras. */
  .hero__lead {
    margin: clamp(26px, 4vw, 40px) auto 0;
    max-width: 56ch;
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.55;
    text-align: justify;
    text-align-last: center;
    hyphens: auto;
    color: var(--rd-ink);
    text-shadow: 0 0 16px rgba(255, 255, 255, .22);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(28px, 3.4vw, 34px);
  }
  /* El botón rojo es la zona más encendida de la pantalla después del logo. */
  .hero__actions :global(.btn--primary) {
    box-shadow: 0 0 22px rgba(140, 20, 32, .55);
  }
  .hero__actions :global(.btn) { text-shadow: 0 0 10px rgba(255, 255, 255, .3); }
  /* En una pantalla de 1000px de medida, el botón de la maqueta se queda corto. */
  @media (min-width: 900px) {
    .hero__actions :global(.btn) { padding: 17px 30px; font-size: 14px; }
  }

  /* ---------- tesis ---------- */
  .thesis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: clamp(32px, 5vw, 56px);
    align-items: start;
  }
  .thesis__body { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .thesis__aside { min-width: 0; display: flex; justify-content: flex-start; }
  .prose {
    font-size: var(--rd-t-lead);
    line-height: 1.7;
    color: var(--rd-ink-2);
    max-width: 62ch;
  }

  /* ---------- tarjetas ---------- */
  /* La rejilla es una sola pantalla, no tres: así se conserva el filete
     compartido de 1px, que ya se lee como tabla de terminal.
     Una o tres columnas, nunca dos: con `auto-fit` los servicios caían 2+1 y la
     celda vacía dejaba colgando un bloque de grafito dentro del marco. */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    /* Borde compartido de 1px: el gap es el propio grafito. */
    gap: 1px;
    background: var(--rd-graphite);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .cards { grid-template-columns: repeat(3, 1fr); }
  }
  .card {
    background: var(--rd-black);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .card__rule { width: 26px; height: 6px; background: var(--rd-red); }
  .card__title { font-size: var(--rd-t-h3); }
  .card__body { font-size: var(--rd-t-body); line-height: 1.7; color: var(--rd-ink-3); }

  /* Decir en voz alta lo que no se hace vale la pena; gritarlo, no. Deja de ser
     un rótulo rojo a cuerpo de texto y pasa a ser una acotación al margen: sin
     rojo, un punto más pequeña y colgada de un filete, como la nota que corrige
     al pie de una tabla. Sigue explícita, deja de competir con las tarjetas. */
  .not {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: clamp(26px, 3vw, 32px);
    align-items: baseline;
    border-left: 1px solid var(--rd-graphite);
    padding-left: 16px;
  }
  .not__label {
    font-family: var(--rd-mono);
    font-size: var(--rd-t-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rd-ink-4);
    flex: none;
  }
  .not__text {
    font-family: var(--rd-mono);
    font-size: var(--rd-t-note);
    line-height: 1.7;
    color: var(--rd-ink-4);
    max-width: 70ch;
  }

  /* ---------- proceso ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: clamp(24px, 3vw, 32px);
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--rd-graphite);
    padding-top: 20px;
    min-width: 0;
  }
  .step__when { margin: 0; }
  .step__title { font-size: 20px; }

  /* ---------- contacto ---------- */
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: clamp(36px, 5vw, 48px);
    align-items: start;
  }
  .contact__intro { min-width: 0; }
  .contact__lead { margin-top: 18px; font-size: var(--rd-t-lead); max-width: 46ch; }

  .channels {
    margin: 32px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .channel { display: flex; flex-direction: column; gap: 6px; }
  .channel__k {
    font-family: var(--rd-mono);
    font-size: var(--rd-t-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rd-ink-4);
  }
  .channel__v { margin: 0; font-family: var(--rd-mono); font-size: 16px; }
  .channel__v a { color: var(--rd-ink); }
  .channel__v a:hover { color: var(--rd-red-ink); }

  .contact__panel {
    background: var(--rd-panel);
    padding: clamp(22px, 3vw, 32px);
    min-width: 0;
  }

  /* Un correo en línea es un blanco táctil de 14px de alto: aquí se le da
     cuerpo, también en la tableta, que no entra en el corte de teléfono. */
  @media (max-width: 860px), (pointer: coarse) {
    .channel__v a { display: inline-block; padding-block: 13px; }
  }

  /* ---------- teléfono ----------
     El ancho manda: una columna, botones que se reparten la línea y bordes
     que sustituyen al aire que ya no sobra. */
  @media (max-width: 599px) {
    /* El pliegue de un teléfono es corto: con el aire de escritorio el hero se
       pasaba del alto de la pantalla. */
    .hero { padding-block: 64px 60px; }

    /* Toda la óptica baja un punto. En una pantalla de mano el cañón y la
       viñeta ocupan proporcionalmente mucho más que en un monitor, y lo que en
       escritorio es atmósfera aquí se convierte en velo sobre el texto. */
    .hero::before {
      background:
        radial-gradient(120% 175% at 50% 175%,
          transparent 70%,
          rgba(255, 255, 255, .024) 78%,
          rgba(255, 255, 255, .008) 86%,
          transparent 96%),
        radial-gradient(78% 88% at 50% 30%,
          rgba(140, 20, 32, .19) 0%, rgba(140, 20, 32, .07) 46%, transparent 78%),
        radial-gradient(100% 90% at 50% 26%, rgba(255, 255, 255, .018), transparent 78%);
    }
    .hero::after {
      background:
        var(--rd-scan-soft),
        radial-gradient(130% 130% at 50% 45%, transparent 66%, rgba(0, 0, 0, .22) 100%);
    }

    /* Justificar con tres o cuatro palabras por renglón no es justificar: o
       abre ríos entre palabras o parte `sis-temas` y `ha-cen`. A esta medida el
       centrado es la forma correcta de la misma intención. */
    .hero__lead {
      text-align: center;
      hyphens: manual;
    }

    /* Con el prompt y el cursor, la línea sólo cabe entera apretando el
       interletraje. */
    .hero__tagline { letter-spacing: 0.04em; gap: 5px; }

    /* El selector es lo primero que se ve y no debería serlo: se aprieta de
       flanco, conservando los 44px de diana que pide el dedo. */
    .hero__langs { top: 10px; }
    .hero__langs :global(.langs) { gap: 2px; }
    .hero__langs :global(.langs__item) { padding: 15px 12px; letter-spacing: 0.08em; }

    .hero__actions { gap: 10px; width: 100%; }
    .hero__actions .btn { flex: 1 1 0; min-width: 132px; }

    .thesis { gap: 30px; }
    .thesis__aside { width: 100%; }

    .card { padding: 24px 20px; }
    .not { margin-top: 24px; padding-left: 14px; }

    .steps { gap: 26px; }
    .step { padding-top: 18px; }

    .contact { gap: 34px; }
    .channels { gap: 20px; }
    .contact__panel {
      /* La tarjeta ocupa el canalón: dentro de ella el aire vale más. */
      margin-inline: calc(-1 * var(--rd-gutter));
      border-inline: 0;
      border-radius: 0;
      padding: 24px var(--rd-gutter) 28px;
    }
  }
</style>
